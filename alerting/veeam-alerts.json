{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "veeam",
      "folder": "Veeam",
      "interval": "1m",
      "rules": [
        {
          "uid": "veeam-job-failed",
          "title": "VeeamJobFailed",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "veeam_job_last_result and on(instance, job_name) veeam_job_running == 0",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "eq",
                      "params": [
                        2
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "45m",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Job {{ $labels.job_name }} on {{ $labels.instance }} failed"
          }
        },
        {
          "uid": "veeam-job-warning",
          "title": "VeeamJobWarning",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "veeam_job_last_result",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "eq",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "45m",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Job {{ $labels.job_name }} on {{ $labels.instance }} ended with a warning"
          }
        },
        {
          "uid": "veeam-object-failed",
          "title": "VeeamObjectFailed",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "veeam_object_last_result",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "eq",
                      "params": [
                        2
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "45m",
          "isPaused": false,
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "{{ $labels.object }} in {{ $labels.job_name }} on {{ $labels.instance }} not backed up"
          }
        },
        {
          "uid": "veeam-object-backup-too-old",
          "title": "VeeamObjectBackupTooOld",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "(time() - veeam_object_last_success_timestamp_seconds) / 3600",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        26
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "isPaused": false,
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "Last backup of {{ $labels.object }} in {{ $labels.job_name }} on {{ $labels.instance }} is {{ printf \"%.0f\" $values.A.Value }} hours old"
          }
        },
        {
          "uid": "veeam-object-no-backup",
          "title": "VeeamObjectNoBackup",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "veeam_object_last_result unless on(instance, job_name, object) veeam_object_last_success_timestamp_seconds",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "eq",
                      "params": [
                        2
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "45m",
          "isPaused": false,
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "{{ $labels.object }} in {{ $labels.job_name }} on {{ $labels.instance }} failed and has no backup within the lookback of the exporter"
          }
        },
        {
          "uid": "veeam-job-not-run",
          "title": "VeeamJobNotRun",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "(time() - veeam_job_last_run_timestamp_seconds) / 3600 and on(instance, job_name) veeam_job_enabled == 1 and on(instance, job_name) veeam_job_info{schedule!=\"none\"}",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        26
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "1h",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Job {{ $labels.job_name }} on {{ $labels.instance }} has not run for {{ printf \"%.0f\" $values.A.Value }} hours"
          }
        },
        {
          "uid": "veeam-job-never-run",
          "title": "VeeamJobNeverRun",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "count_over_time((veeam_job_last_result == -1 unless on(instance, job_name) veeam_job_last_run_timestamp_seconds and on(instance, job_name) veeam_job_enabled == 1 and on(instance, job_name) veeam_job_info{schedule!=\"none\"})[28h:15m]) and on(instance, job_name) (veeam_job_last_result == -1 unless on(instance, job_name) veeam_job_last_run_timestamp_seconds and on(instance, job_name) veeam_job_enabled == 1 and on(instance, job_name) veeam_job_info{schedule!=\"none\"})",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        103
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Job {{ $labels.job_name }} on {{ $labels.instance }} has a schedule but has never run"
          }
        },
        {
          "uid": "veeam-repository-full",
          "title": "VeeamRepositoryFull",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "1 - veeam_repository_free_bytes / veeam_repository_capacity_bytes and veeam_repository_capacity_bytes > 0",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.85
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "1h",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Repository {{ $labels.repository }} on {{ $labels.instance }} is {{ humanizePercentage $values.A.Value }} full"
          }
        },
        {
          "uid": "veeam-repository-offline",
          "title": "VeeamRepositoryOffline",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "veeam_repository_online",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "eq",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "15m",
          "isPaused": false,
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "Repository {{ $labels.repository }} on {{ $labels.instance }} is offline"
          }
        },
        {
          "uid": "veeam-license-expiring",
          "title": "VeeamLicenseExpiring",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "(veeam_license_expiration_timestamp_seconds - time()) / 86400",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        30
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ if lt $values.A.Value 0.0 }}Veeam license on {{ $labels.instance }} has expired{{ else }}Veeam license on {{ $labels.instance }} expires in {{ printf \"%.0f\" $values.A.Value }} days{{ end }}"
          }
        },
        {
          "uid": "veeam-license-invalid",
          "title": "VeeamLicenseInvalid",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "veeam_license_valid",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "eq",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "1h",
          "isPaused": false,
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "Veeam license on {{ $labels.instance }} is not valid"
          }
        },
        {
          "uid": "veeam-support-expiring",
          "title": "VeeamSupportExpiring",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "(veeam_license_support_expiration_timestamp_seconds - time()) / 86400",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        30
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ if lt $values.A.Value 0.0 }}Veeam support on {{ $labels.instance }} has ended{{ else }}Veeam support on {{ $labels.instance }} ends in {{ printf \"%.0f\" $values.A.Value }} days{{ end }}"
          }
        },
        {
          "uid": "veeam-exporter-stale",
          "title": "VeeamExporterStale",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "(time() - windows_textfile_mtime_seconds{file=~\".*veeam_(jobs|objects|repositories)\\\\.prom\"}) / 3600",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Veeam exporter file {{ $labels.file }} on {{ $labels.instance }} has not been updated for {{ printf \"%.1f\" $values.A.Value }} hours"
          }
        },
        {
          "uid": "veeam-exporter-license-stale",
          "title": "VeeamExporterLicenseStale",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "(time() - windows_textfile_mtime_seconds{file=~\".*veeam_license\\\\.prom\"}) / 3600",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        48
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Veeam license file on {{ $labels.instance }} has not been updated for {{ printf \"%.0f\" $values.A.Value }} hours"
          }
        },
        {
          "uid": "veeam-exporter-collector-failed",
          "title": "VeeamExporterCollectorFailed",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "veeam_exporter_collector_success{collector!=\"license\"}",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "eq",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "30m",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Veeam exporter collector {{ $labels.collector }} on {{ $labels.instance }} has been failing for 30 minutes"
          }
        },
        {
          "uid": "veeam-exporter-license-collector-failed",
          "title": "VeeamExporterLicenseCollectorFailed",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "max_over_time(veeam_exporter_collector_success{collector=\"license\"}[25h])",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "eq",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "0s",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Veeam exporter collector license on {{ $labels.instance }} has not succeeded for 25 hours"
          }
        },
        {
          "uid": "veeam-exporter-missing",
          "title": "VeeamExporterMissing",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "max by (instance) (max_over_time(veeam_exporter_info[7d])) unless on(instance) veeam_exporter_info",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "15m",
          "isPaused": false,
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "No Veeam exporter data from {{ $labels.instance }} for 15 minutes: windows_exporter down, port blocked or files gone"
          }
        },
        {
          "uid": "veeam-exporter-textfile-error",
          "title": "VeeamExporterTextfileError",
          "condition": "B",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${VEEAM_PROMETHEUS_DATASOURCE_UID}",
              "model": {
                "refId": "A",
                "expr": "windows_exporter_collector_success{collector=\"textfile\"} and on(instance) max by (instance) (max_over_time(veeam_exporter_info[7d]))",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "eq",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "15m",
          "isPaused": false,
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "windows_exporter on {{ $labels.instance }} rejects a file in its textfile directory"
          }
        }
      ]
    }
  ]
}
