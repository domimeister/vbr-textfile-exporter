# HELP veeam_license_info Installed Veeam license (value always 1)
# TYPE veeam_license_info gauge
veeam_license_info{edition="EnterprisePlus",license_type="Rental",status="Valid",licensed_to="Muster & Söhne AG \"IT\" \\ Basel"} 1
# HELP veeam_license_valid 1 if the license status is Valid, otherwise 0
# TYPE veeam_license_valid gauge
veeam_license_valid 1
# HELP veeam_license_expiration_timestamp_seconds License expiration as Unix time (missing for perpetual licenses)
# TYPE veeam_license_expiration_timestamp_seconds gauge
veeam_license_expiration_timestamp_seconds 1806447600
# HELP veeam_license_support_expiration_timestamp_seconds Support expiration as Unix time
# TYPE veeam_license_support_expiration_timestamp_seconds gauge
veeam_license_support_expiration_timestamp_seconds 1806447600
# HELP veeam_license_instances_licensed Licensed instances
# TYPE veeam_license_instances_licensed gauge
veeam_license_instances_licensed 1000
# HELP veeam_license_instances_used Used instances
# TYPE veeam_license_instances_used gauge
veeam_license_instances_used 2
